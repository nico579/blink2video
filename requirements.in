aiohttp
blinkpy
certifi
tzdata
imageio-ffmpeg
backports.zoneinfo; python_version < "3.9"

# aiortc tire par defaut cryptography>=49 (donc cffi>=2). Sans venv dedie,
# ce depot s'installe sur le python systeme partage avec d'autres outils
# (verifie : timezonefinder, pas un besoin de blink2video, exige cffi<2) -
# plafonner ici evite qu'une simple mise a jour de dependances ne casse un
# outil totalement sans rapport. A retirer si ce depot passe un jour a un
# venv dedie pour son execution (pas seulement pour ses builds).
aiortc
cryptography<46
pyopenssl<26
cffi<2

# pyee (tire par aiortc) est passe a 14.0.0 sans avertissement et exige
# desormais Python >=3.12, incompatible avec le Python 3.11 vise par le
# README et teste par la CI (casse silencieusement l'installation des
# dependances minimales sous 3.11). Plafonner ici tant que 3.11 reste une
# cible du projet.
pyee<14
