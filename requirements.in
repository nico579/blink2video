# Dépendances directes de blink2video, déclarées ici et nulle part ailleurs
# (runtime.DEPENDANCES n'en garde que celles que le démarrage exige).
# requirements.txt les verrouille toutes, indirectes comprises : version
# exacte et empreintes SHA-256, pour Windows, macOS et Linux d'un seul
# fichier. Après toute modification ici, régénérer les deux verrous avec uv
# (pip install uv), depuis la racine du dépôt :
#
#   uv pip compile requirements.in --universal --python-version 3.11 --generate-hashes -o requirements.txt
#   uv pip compile requirements-build.in --universal --python-version 3.11 --generate-hashes -o requirements-build.txt
#
# Une seule mise à jour, sans toucher au reste : ajouter
# --upgrade-package <paquet> à la première commande.
#
# pip-compile, employé jusqu'à la 0.14, ne résout que pour la machine où il
# tourne : le verrou de construction manquait des paquets d'autres systèmes
# et de ceux ajoutés ici depuis sa dernière régénération, et se complétait à
# la main. uv --universal produit un seul fichier valable partout, que le pip
# d'un Python nu lit comme un requirements.txt ordinaire.
aiohttp
blinkpy
certifi
tzdata
imageio-ffmpeg
backports.zoneinfo; python_version < "3.9"
# Dossier d'état standard de l'OS (même convention que lidar2map et watch2notif).
platformdirs

# Briques communes aux quatre applications : ici la sortie du service systemd
# (autostart.py). Sans l'extra « tray », la bibliothèque n'exige rien de plus
# que la bibliothèque standard : l'icône (pystray, Pillow) reste facultative
# depuis les sources, et absente de l'image Docker. Fourchette : une version
# incompatible ne peut pas entrer dans le verrou.
nico579-commons>=0.4.13,<0.5

# aiortc tire par defaut cryptography>=49 (donc cffi>=2). Sans venv dedie,
# ce depot s'installe sur le python systeme partage avec d'autres outils
# (verifie : timezonefinder, pas un besoin de blink2video, exige cffi<2) -
# plafonner ici evite qu'une simple mise a jour de dependances ne casse un
# outil totalement sans rapport. A retirer si ce depot passe un jour a un
# venv dedie pour son execution (pas seulement pour ses builds).
aiortc
cryptography<46
pyopenssl<26
cffi<2

# pyee (tire par aiortc) est passe a 14.0.0 sans avertissement et exige
# desormais Python >=3.12, incompatible avec le Python 3.11 vise par le
# README et teste par la CI (casse silencieusement l'installation des
# dependances minimales sous 3.11). Plafonner ici tant que 3.11 reste une
# cible du projet.
pyee<14
