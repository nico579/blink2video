# Secrets et session Blink : jetons d'accès au compte Amazon.
blink_auth.json
blink_auth.json.*
# I-02 : le temporaire d'écriture ne remplace plus l'extension .json par
# .tmp (blink_auth.tmp, non couvert par le motif ci-dessus), il porte
# maintenant pid+jeton pour ne jamais être partagé entre processus.
blink_auth.*.tmp
watch_config.json
blink_reglages.json
blink_home.txt
blink_langue.txt
blink_suppression_auto.json
.blink_raccourci_cree
.blink_configuration_initiale_effectuee

# Registres d'état : contiennent identifiants de compte, numéros de série,
# noms de caméras et horaires de présence.
.blink_*.json
.blink_*.json.*
.blink_*.lock
watch.log
maj.log
merge.log
serve_erreurs.log
direct.log

# Images de surveillance du domicile. Rien de tout cela n'a vocation à
# quitter la machine.
Blink_Clips/
Blink_Normalized/
Blink_Excluded/
Blink_Daily/
Blink_Weekly/
Blink_Monthly/
.blink_thumbs/

# Fiches des instances en cours, une par processus, effacees a leur mort.
.blink_run/

# ffmpeg embarqué (84 Mo) et produits de construction : refabriqués par
# build.py, ils n'ont pas leur place dans l'historique.
_vendor/
build/
dist/
build_venv/
build-xr-tester/
dist-xr-tester/
build-win7/
dist-win7/
build_venv_win7/
__pycache__/
*.pyc

# Vidéo de démonstration produite par « blink2video smoketest ».
smoketest.mp4

# Scripts d'essai ponctuels contre le compte Blink réel (endpoints non
# documentés, reproductions manuelles) : jamais destinés au dépôt public.
essai_*.py

# Ressource VERSIONINFO régénérée à chaque build par blink2video.spec.
.version_info.txt
